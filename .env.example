# Telegram bot token from @BotFather
TELEGRAM_TOKEN=your-telegram-bot-token

# Only this Telegram user ID can send audio notes to the bot
# Get your ID by messaging @userinfobot on Telegram
ALLOWED_USER_ID=123456789

# Gemini API key from Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key

# Gemini model to use (default: gemini-3-pro-preview)
GEMINI_MODEL=gemini-3-pro-preview

# Git remote URL for the notes repo (SSH preferred)
# For testing:  git@github.com:youruser/audio-to-go-test-notes.git
# For deploy:   git@github.com:youruser/audio-to-go-notes.git
GIT_REMOTE_URL=git@github.com:youruser/audio-to-go-notes.git
GIT_USER_EMAIL=your@email.com
GIT_USER_NAME=Your Name

# Timezone for note timestamps (e.g. Europe/Rome, America/New_York)
TZ=Europe/Rome

# Directory where notes are stored (Docker default: /app/notes; override for local dev)
# NOTES_DIR=./notes
